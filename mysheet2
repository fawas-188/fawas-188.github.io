/* Google Font */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:linear-gradient(135deg,#020617,#0f172a,#1e293b);
    color:white;
    min-height:100vh;
}

/* Navigation */
nav{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 50px;
    background:rgba(255,255,255,0.05);
    backdrop-filter:blur(10px);
    position:sticky;
    top:0;
}

.logo{
    font-size:28px;
    font-weight:700;
    color:#00ffcc;
}

nav ul{
    list-style:none;
    display:flex;
    gap:20px;
}

nav ul li a{
    text-decoration:none;
    color:white;
    transition:0.3s;
}

nav ul li a:hover{
    color:#00ffcc;
}

/* Hero Section */
.hero{
    text-align:center;
    padding:100px 20px;
}

.hero img{
    width:220px;
    height:220px;
    border-radius:50%;
    object-fit:cover;
    border:4px solid #00ffcc;
    box-shadow:0 0 25px #00ffcc;
}

.hero h1{
    font-size:55px;
    margin-top:20px;
}

.hero h2{
    color:#00ffcc;
    margin-top:10px;
}

.hero p{
    max-width:700px;
    margin:20px auto;
    color:#cbd5e1;
}

.btn{
    display:inline-block;
    margin-top:20px;
    padding:12px 28px;
    background:#00ffcc;
    color:#000;
    text-decoration:none;
    border-radius:30px;
    font-weight:bold;
    transition:0.3s;
}

.btn:hover{
    transform:translateY(-5px);
    box-shadow:0 0 20px #00ffcc;
}

/* Sections */
section{
    padding:70px 10%;
}

.section-title{
    text-align:center;
    font-size:40px;
    margin-bottom:40px;
    color:#00ffcc;
}

/* About */
.about{
    text-align:center;
    max-width:900px;
    margin:auto;
}

.about p{
    line-height:1.8;
    color:#cbd5e1;
}

/* Skills */
.skills-container{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:20px;
}

.skill-card{
    background:rgba(255,255,255,0.05);
    padding:30px;
    border-radius:15px;
    text-align:left;
    transition:0.3s;
    border:1px solid rgba(255,255,255,0.1);
}

.skill-card:hover{
    transform:translateY(-10px);
    box-shadow:0 0 20px #00ffcc;
}

.skill-card h3{
    color:#00ffcc;
}

/* Projects */
.projects-container{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:25px;
}

.project-card{
    background:rgba(255,255,255,0.05);
    border-radius:15px;
    overflow:hidden;
    transition:0.3s;
}

.project-card:hover{
    transform:scale(1.05);
    box-shadow:0 0 20px #00ffcc;
}

.project-card img{
    width:100%;
    height:220px;
    object-fit:cover;
}

.project-content{
    padding:20px;
}

.project-content h3{
    color:#00ffcc;
    margin-bottom:10px;
}

.project-content p{
    color:#cbd5e1;
}

/* Certifications */
.cert-list{
    display:flex;
    flex-wrap:wrap;
    gap:20px;
    justify-content:center;
}

.cert-card{
    background:rgba(255,255,255,0.05);
    padding:20px;
    border-radius:12px;
    width:280px;
    text-align:center;
    border:1px solid rgba(255,255,255,0.1);
}

.cert-card:hover{
    box-shadow:0 0 20px #00ffcc;
}

/* Contact */
.contact{
    text-align:center;
}

.contact a{
    color:#00ffcc;
    text-decoration:none;
}

.social-icons{
    margin-top:20px;
}

.social-icons a{
    display:inline-block;
    margin:10px;
    font-size:24px;
    color:white;
    transition:0.3s;
}

.social-icons a:hover{
    color:#00ffcc;
    transform:scale(1.2);
}

/* Footer */
footer{
    text-align:center;
    padding:20px;
    background:#010409;
    color:#94a3b8;
}

/* Scrollbar */
::-webkit-scrollbar{
    width:10px;
}

::-webkit-scrollbar-track{
    background:#0f172a;
}

::-webkit-scrollbar-thumb{
    background:#00ffcc;
    border-radius:10px;
}

/* Responsive */
@media(max-width:768px){

    nav{
        flex-direction:column;
        padding:20px;
    }

    nav ul{
        margin-top:15px;
        flex-wrap:wrap;
        justify-content:center;
    }

    .hero h1{
        font-size:38px;
    }

    .hero h2{
        font-size:20px;
    }
}